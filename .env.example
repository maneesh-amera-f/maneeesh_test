# .env.example — Logz.io API access (template; copy to .env and fill in real tokens).
# .env is gitignored; NEVER commit real tokens.
#
# API token: Logz.io → Settings → Tools → Manage tokens → API tokens.
# Each Logz.io environment/account has its own token.
#
# Region-specific API base URL (must match the account's region):
#   US East   https://api.logz.io
#   EU        https://api-eu.logz.io
#   UK        https://api-uk.logz.io
#   AU        https://api-au.logz.io
#   CA        https://api-ca.logz.io
# Full list: https://api-docs.logz.io/docs/logz/logz-io-api/

LOGZIO_API_BASE_URL=https://api.logz.io
LOGZIO_API_TOKEN_DEV=
LOGZIO_API_TOKEN_STAGE=
LOGZIO_API_TOKEN_PROD=
# Optional per-environment base-URL overrides (uncomment if regions differ):
# LOGZIO_API_BASE_URL_DEV=https://api.logz.io
# LOGZIO_API_BASE_URL_STAGE=https://api.logz.io
# LOGZIO_API_BASE_URL_PROD=https://api.logz.io
